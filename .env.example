# Zenith API the app talks to, through the SDK. Server-side calls use this.
ZENITH_API_URL=http://localhost:8787

# Same API, exposed to the browser so the checkout page can open the SSE stream.
NEXT_PUBLIC_ZENITH_API_URL=http://localhost:8787

# Base URL this app runs at. Used to build checkout links.
NEXT_PUBLIC_CHECKOUT_BASE_URL=http://localhost:3000
