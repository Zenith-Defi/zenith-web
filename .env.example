# URL of the zenith-api instance this app talks to (through the SDK).
# Read at runtime on the server for dashboard calls, and passed to the browser
# by the checkout page for the SSE stream. Local: http://localhost:8787. In
# production set it to your deployed zenith-api (the Render URL).
# See https://github.com/Zenith-Defi/zenith-api.
ZENITH_API_URL=http://localhost:8787

# Base URL this app itself runs at, used server-side to build checkout links.
# Local: http://localhost:3000. In production set it to the app's own public URL
# (the Vercel domain).
CHECKOUT_BASE_URL=http://localhost:3000
