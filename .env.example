# URL of the zenith-api instance this app talks to (through the SDK).
# Used by server-side calls. Local: http://localhost:8787. In production set
# it to your deployed zenith-api. See https://github.com/Zenith-Defi/zenith-api.
ZENITH_API_URL=http://localhost:8787

# The same API URL, exposed to the browser so the checkout page can open the
# SSE stream. NEXT_PUBLIC_* values are inlined into the client bundle at build
# time, so this must be set before `pnpm build`, not only at runtime.
NEXT_PUBLIC_ZENITH_API_URL=http://localhost:8787

# Base URL this app itself runs at, used to build checkout links. Local:
# http://localhost:3000. In production set it to the app's own public URL
# (for example the Vercel domain). Also inlined at build time.
NEXT_PUBLIC_CHECKOUT_BASE_URL=http://localhost:3000
